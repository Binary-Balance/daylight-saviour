{
  "name": "@daylight-saviour/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./dist/index.js",
    "./australian-zone-runtime": "./src/australian-zone-runtime.js"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @daylight-saviour/contracts",
    "build": "tsc --project tsconfig.build.json && cp src/australian-zone-runtime.js dist/ && node scripts/use-compiled-contracts.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daylight-saviour/contracts": "*"
  }
}
