{
  "source": {
    "include": ["packages/*/src/**/*.ts"],
    "exclude": ["packages/*/src/**/*.d.ts"]
  },
  "capture": [
    "package.json",
    "package-lock.json",
    "tsconfig.base.json",
    "scripts/seshat-collect-node.mjs",
    "apps",
    "packages",
    "services",
    "node_modules"
  ],
  "workers": 4,
  "mutationOperators": ["comparison", "logical", "arithmetic", "boolean"],
  "setups": [
    {
      "name": "packages",
      "runner": "node",
      "cwd": ".",
      "timeoutMs": 60000,
      "typecheck": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--project",
        "packages/tsconfig.json"
      ],
      "test": [
        "node",
        "--test",
        "--test-concurrency=1",
        "--test-reporter={seshatReporter}",
        "packages/*/tests/*.test.mjs"
      ],
      "coverage": {
        "command": [
          "node",
          "scripts/seshat-collect-node.mjs",
          "packages/*/tests/*.test.mjs"
        ],
        "report": "coverage/seshat-packages.json"
      }
    }
  ],
  "thresholds": {
    "maxCrap": 30,
    "maxCognitiveComplexity": 15,
    "minMutationScore": 80,
    "maxInferredAny": 7,
    "maxTypeEscapes": 0
  }
}
