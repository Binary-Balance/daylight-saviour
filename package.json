{
  "name": "daylight-saviour",
  "version": "0.0.0",
  "private": true,
  "description": "Daylight Saviour product monorepo",
  "license": "Apache-2.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver": false
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "uuid": "11.1.1",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "android": "npm run android --workspace @daylight-saviour/mobile",
    "audit": "node scripts/audit.mjs",
    "dependencies:check": "npm ls react react-dom react-test-renderer uuid && npm run doctor",
    "doctor": "npm exec --workspace=@daylight-saviour/mobile -- expo-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:build": "az bicep build --file infra/modules/minimal-functions-platform.bicep --outfile infra/tests/minimal-functions-platform.generated.json",
    "infra:test": "node --test infra/tests/*.test.mjs",
    "infra:validate": "npm run infra:build && npm run infra:test",
    "lint": "eslint .",
    "native:generate:android": "npm exec --workspace=@daylight-saviour/mobile -- expo prebuild --platform android --clean --no-install",
    "start": "npm run start --workspace @daylight-saviour/mobile",
    "test": "npm run test:audit && npm run test:android-fcm-build-input && npm run test:hosted-ios-benchmark && npm run test --workspace @daylight-saviour/contracts && npm run test --workspace @daylight-saviour/time-zone-data && npm run test --workspace @daylight-saviour/domain && npm run test --workspace @daylight-saviour/copy && npm run test --workspace @daylight-saviour/mobile -- --runInBand && npm run test --workspace @daylight-saviour/notifications",
    "test:audit": "node --test scripts/audit.test.mjs",
    "test:android-fcm-build-input": "node --test apps/mobile/build/android-fcm-build-input.test.cjs apps/mobile/src/features/change-reminders/reminder-registration-endpoint.test.cjs apps/mobile/src/features/time-zone-data/time-zone-data-remote-configuration.test.cjs",
    "test:hosted-ios-benchmark": "node --test scripts/hosted-ios-benchmark-workflow.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web": "npm run web --workspace @daylight-saviour/mobile",
    "web:export": "npm exec --workspace=@daylight-saviour/mobile -- expo export --platform web"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "eslint-config-expo": "57.0.0",
    "expo-doctor": "1.20.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.3"
  }
}
