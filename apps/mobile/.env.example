# Public build-time configuration only. Expo bundles every EXPO_PUBLIC_ value
# into the app, so none of them is a secret. Placeholder values are
# intentionally nonproduction and unusable. Never commit private signing
# material here.
EXPO_PUBLIC_TIME_ZONE_DATA_MANIFEST_URL=https://time-zone-data.example.invalid/manifest.json
EXPO_PUBLIC_TIME_ZONE_DATA_TRUSTED_KEYS_JSON={"replace-with-nonproduction-key-id":"REPLACE_WITH_RAW_32_BYTE_ED25519_PUBLIC_KEY_BASE64"}
EXPO_PUBLIC_REMINDER_REGISTRATION_URL=https://reminders.example.invalid/registrations

# Android Firebase configuration. Set this only to build Android with Firebase,
# and keep the real file outside the checkout. A path that cannot be read stops
# every Expo command.
# DAYLIGHT_SAVIOUR_ANDROID_GOOGLE_SERVICES_FILE=/absolute/path/outside/checkout/google-services.json
