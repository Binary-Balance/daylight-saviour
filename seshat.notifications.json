{
  "source": {
    "include": ["services/notifications/src/**/*.ts"],
    "exclude": ["services/notifications/src/**/*.test.ts"]
  },
  "capture": [
    "package.json",
    "package-lock.json",
    "tsconfig.base.json",
    "scripts/seshat-collect-node.mjs",
    "apps",
    "packages",
    "services",
    "node_modules"
  ],
  "workers": 4,
  "setups": [
    {
      "name": "notifications",
      "runner": "node",
      "cwd": ".",
      "timeoutMs": 60000,
      "typecheck": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--project",
        "services/notifications/tsconfig.json"
      ],
      "test": [
        "node",
        "--test",
        "--test-concurrency=1",
        "--test-reporter={seshatReporter}",
        "services/notifications/src/*.test.ts"
      ],
      "coverage": {
        "command": [
          "node",
          "scripts/seshat-collect-node.mjs",
          "services/notifications/src/*.test.ts"
        ],
        "report": "coverage/seshat-notifications.json"
      }
    }
  ],
  "thresholds": {
    "maxCrap": 30,
    "maxCognitiveComplexity": 15,
    "minMutationScore": 80,
    "maxInferredAny": 12,
    "maxTypeEscapes": 0
  }
}
